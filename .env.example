# All of these live in the Vercel dashboard: Project -> Settings -> Environment Variables.
# Copy this file to .env for local testing only (Vercel reads env vars from its dashboard, not this file).

# ------------------------------------------------------------
# telegram bot token
# ------------------------------------------------------------
# 1. message @BotFather on Telegram
# 2. send /newbot, follow the prompts (name + username ending in "bot")
# 3. paste the token BotFather gives you here
TELEGRAM_BOT_TOKEN=

# ------------------------------------------------------------
# your telegram user id (numeric)
# ------------------------------------------------------------
# message @userinfobot on Telegram — it replies with your numeric id.
# the bot will refuse to talk to anyone else.
MY_TELEGRAM_ID=

# ------------------------------------------------------------
# what to call the buddy (defaults to Yuki)
# ------------------------------------------------------------
BUDDY_NAME=Yuki

# ------------------------------------------------------------
# turso (hosted sqlite) — https://turso.tech (free, github signup)
# ------------------------------------------------------------
# 1. create a database in the turso dashboard
# 2. on its page, click "Connect" — copy the URL (libsql://...)
# 3. generate an auth token there and copy it (shown once)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ------------------------------------------------------------
# webhook secret
# ------------------------------------------------------------
# Any random string you make up. Shared between Telegram and our webhook so
# random internet traffic to /api/webhook can't inject fake messages.
# Also used to gate /api/setup and /api/migrate.
# Suggestion: `openssl rand -hex 32`
WEBHOOK_SECRET=

# ------------------------------------------------------------
# openrouter — NOT needed for step 1, wired up in a later step
# ------------------------------------------------------------
OPENROUTER_API_KEY=
MODEL_NAME=deepseek/deepseek-chat
